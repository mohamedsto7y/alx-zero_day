# Copy to .env — it is read automatically, so you never set shell variables.
MOSANED_PROVIDER=stub          # stub | ollama | gemini
MOSANED_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
# GEMINI_API_KEY=
MOSANED_LANG=en
MOSANED_MAX_TURNS=16

# Let the model word each question: warmer, but one extra call per turn.
# Leave off on a local model, turn on when latency is cheap.
MOSANED_PHRASE_QUESTIONS=0

# Print how long each model call takes.
MOSANED_DEBUG_TIMING=0

# Refuse to start until a doctor has signed the emergency criteria.
MOSANED_REQUIRE_REVIEW=0
