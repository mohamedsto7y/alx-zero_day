# Copy to .env and adjust. Nothing here is required to run the stub.
MOSANED_PROVIDER=stub          # stub | ollama | gemini
MOSANED_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
# GEMINI_API_KEY=
MOSANED_LANG=en
MOSANED_MAX_TURNS=16
MOSANED_REQUIRE_REVIEW=0       # set to 1 before any real patient
