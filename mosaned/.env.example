# Copy to .env — it is read automatically, so you never set shell variables.
MOSANED_PROVIDER=gemini        # gemini | anthropic | ollama | stub
GEMINI_MODEL=gemini-3.7-flash
MOSANED_MODEL=qwen2.5:7b-instruct   # only used by the ollama provider
OLLAMA_HOST=http://localhost:11434
GEMINI_API_KEY=            # get one free at aistudio.google.com/apikey
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Domains the answer path may search. This list is the whole of the curation:
# no corpus, no scraping, nothing to keep up to date.
MOSANED_SOURCE_DOMAINS=nhs.uk,msdmanuals.com,who.int,mayoclinic.org,cdc.gov
MOSANED_LANG=en
MOSANED_MAX_TURNS=16

# Let the model word each question: warmer, but one extra call per turn.
# Leave off on a local model, turn on when latency is cheap.
MOSANED_PHRASE_QUESTIONS=0

# Print how long each model call takes.
MOSANED_DEBUG_TIMING=0

# Refuse to start until a doctor has signed the emergency criteria.
MOSANED_REQUIRE_REVIEW=0
